<template id="sales_portal_dashboard" name="Sales Portal Dashboard">
  <t t-set="title">Sales Dashboard</t>

  <!-- Tailwind + Chart.js -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@latest/dist/chart.umd.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#1d4ed8',
            secondary: '#facc15',
            success: '#16a34a',
            danger: '#dc2626',
            neutral: '#f3f4f6'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>

  <div class="bg-neutral min-h-screen p-6">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="flex items-center justify-between mb-10">
        <div class="text-left">
          <h1 class="text-4xl font-extrabold text-gray-900">📊 Sales Insights</h1>
          <p class="text-gray-500 mt-2">Real-time metrics and performance</p>
        </div>
        <div class="flex items-center gap-3">
          <img t-att-src="user_image" alt="User" class="w-10 h-10 rounded-full border"/>
          <span class="font-medium text-gray-700"><t t-esc="user_name"/></span>
        </div>
      </div>

      <!-- Filters -->
      <form method="get" class="mb-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4">
        <select name="state" class="p-2 border rounded w-full">
          <option value="">All States</option>
          <t t-foreach="states" t-as="s">
            <option t-att-value="s[0]" t-att-selected="s[0] == selected_state">
              <t t-esc="s[1]"/>
            </option>
          </t>
        </select>
        <select name="user_id" class="p-2 border rounded w-full">
          <option value="">All Users</option>
          <t t-foreach="users" t-as="u">
            <option t-att-value="u.id" t-att-selected="u.id == selected_user">
              <t t-esc="u.name"/>
            </option>
          </t>
        </select>
        <select name="partner_id" class="p-2 border rounded w-full">
          <option value="">All Customers</option>
          <t t-foreach="partners" t-as="p">
            <option t-att-value="p.id" t-att-selected="p.id == selected_partner">
              <t t-esc="p.name"/>
            </option>
          </t>
        </select>
        <input type="date" name="start_date" t-att-value="start_date" class="p-2 border rounded w-full" placeholder="Start Date"/>
        <input type="date" name="end_date" t-att-value="end_date" class="p-2 border rounded w-full" placeholder="End Date"/>
        <button type="submit" class="bg-primary text-white px-4 py-2 rounded w-full">Filter</button>
      </form>

      <!-- KPI Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-6 shadow hover:shadow-md transition">
          <p class="text-sm text-gray-400">Total Sales</p>
          <p class="text-3xl font-semibold text-success mt-1">
            <t t-esc="total_sales"/>
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow hover:shadow-md transition">
          <p class="text-sm text-gray-400">Total Orders</p>
          <p class="text-3xl font-semibold text-primary mt-1">
            <t t-esc="total_orders"/>
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow hover:shadow-md transition">
          <p class="text-sm text-gray-400">Customers</p>
          <p class="text-3xl font-semibold text-secondary mt-1">
            <t t-esc="total_customers"/>
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow hover:shadow-md transition">
          <p class="text-sm text-gray-400">Top Salesperson</p>
          <p class="text-3xl font-semibold text-danger mt-1">
            <t t-esc="top_salesperson"/>
          </p>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        <div class="bg-white p-5 rounded-2xl shadow">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Orders by State</h2>
            <select onchange="renderSingleChart('stateChart', stateData, this.value)" class="p-1 border rounded">
              <option value="bar">Bar</option>
              <option value="pie">Pie</option>
              <option value="doughnut">Doughnut</option>
            </select>
          </div>
          <canvas id="stateChart"></canvas>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Sales Total per User</h2>
            <select onchange="renderSingleChart('userChart', userData, this.value)" class="p-1 border rounded">
              <option value="bar">Bar</option>
              <option value="pie">Pie</option>
              <option value="doughnut">Doughnut</option>
            </select>
          </div>
          <canvas id="userChart"></canvas>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Monthly Sales Trend</h2>
            <select onchange="renderSingleChart('monthlyChart', monthlyData, this.value, 'Monthly Sales')" class="p-1 border rounded">
              <option value="line">Line</option>
              <option value="bar">Bar</option>
            </select>
          </div>
          <canvas id="monthlyChart"></canvas>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Top 5 Customers</h2>
            <select onchange="renderSingleChart('topCustomersChart', topCustomers, this.value)" class="p-1 border rounded">
              <option value="doughnut">Doughnut</option>
              <option value="pie">Pie</option>
              <option value="bar">Bar</option>
            </select>
          </div>
          <canvas id="topCustomersChart"></canvas>
        </div>
      </div>

      <!-- Orders Table -->
      <div class="bg-white rounded-2xl p-6 shadow">
        <input type="text" placeholder="Search orders..." class="mb-4 p-2 border rounded w-full" oninput="searchTable(this.value)"/>
        <table class="min-w-full table-fixed">
          <thead>
            <tr class="bg-gray-100 text-sm text-gray-700">
              <th class="p-2 text-left">Order</th>
              <th class="p-2 text-left">Customer</th>
              <th class="p-2 text-left">Salesperson</th>
              <th class="p-2 text-left">Total</th>
              <th class="p-2 text-left">Status</th>
            </tr>
          </thead>
          <tbody id="orderTable">
            <t t-foreach="orders" t-as="order">
              <tr class="hover:bg-gray-50">
                <td class="p-2"><t t-esc="order.name"/></td>
                <td class="p-2"><t t-esc="order.partner_id.name"/></td>
                <td class="p-2"><t t-esc="order.user_id.name"/></td>
                <td class="p-2"><t t-esc="order.amount_total"/></td>
                <td class="p-2"><t t-esc="order.state"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Chart Logic -->
  <script>
    const stateData = <t t-raw="json_state_data"/>;
    const userData = <t t-raw="json_user_sales"/>;
    const monthlyData = <t t-raw="json_monthly_sales"/>;
    const topCustomers = <t t-raw="json_top_customers"/>;

    let charts = {};

    function renderSingleChart(canvasId, dataObj, type, label='') {
      if (charts[canvasId]) charts[canvasId].destroy();
      charts[canvasId] = new Chart(document.getElementById(canvasId), {
        type,
        data: {
          labels: Object.keys(dataObj),
          datasets: [{
            label: label || undefined,
            data: Object.values(dataObj),
            backgroundColor: ['#60a5fa', '#f87171', '#34d399', '#fbbf24', '#c084fc', '#4ade80', '#a855f7'],
            borderRadius: 8,
            borderColor: '#3b82f6'
          }]
        },
        options: { responsive: true, scales: type === 'bar' || type === 'line' ? { y: { beginAtZero: true } } : {} }
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      renderSingleChart('stateChart', stateData, 'bar');
      renderSingleChart('userChart', userData, 'bar');
      renderSingleChart('monthlyChart', monthlyData, 'line', 'Monthly Sales');
      renderSingleChart('topCustomersChart', topCustomers, 'doughnut');
    });

    function searchTable(value) {
      const rows = document.querySelectorAll("#orderTable tr");
      rows.forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(value.toLowerCase()) ? '' : 'none';
      });
    }
  </script>
</template>
